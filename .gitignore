# macOS
.DS_Store

# Go
/open-tv
/server
iptv.db
*.db-journal
*.db-wal
*.db-shm
.devdata/

# Cliente web construido: lo produce `npm run build` en web/ y lo embebe Go.
# El .gitkeep se versiona a propósito: go:embed falla al compilar si el
# directorio no existe.
/internal/ui/dist/*
!/internal/ui/dist/.gitkeep

# Cliente web
/web/node_modules/
/web/test-results/
/web/playwright-report/

# Fixtures del e2e: catalogo.m3u y hls/ los genera global-setup.ts en cada
# corrida (Tarea 15). El HLS de ffmpeg y el .m3u que lo referencia son
# artefactos, no fuente — los specs que sí son fuente viven en web/tests/e2e/,
# no aquí, así que ignorar el directorio entero es seguro.
/web/tests/fixtures/

# Flutter / Dart
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/ephemeral/
mobile/macos/Flutter/ephemeral/

# IDE
.idea/
.vscode/

# Claude Code — settings.json (compartido) sí se versiona;
# settings.local.json es de cada máquina
.claude/settings.local.json

# Artefactos locales que no viajan al repo público (P1)
docs/prompts/
.claude/

# Salida de goreleaser (root-anchored: NO afecta a internal/ui/dist, el embed)
/dist/
